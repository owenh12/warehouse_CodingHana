# 이 파일을 .env로 복사해 값을 채운다. .env는 git에 커밋되지 않는다(.gitignore).
# 키 값은 코드·로그·알림에 절대 출력되지 않도록 rsidiv.core.secrets에서 SecretStr로만 다룬다.

# --- 한국투자증권 KIS Open API ---
KIS_APP_KEY=
KIS_APP_SECRET=
# 종합계좌번호 앞 8자리 / 상품코드 뒤 2자리
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
# 웹소켓 체결통보 구독용 HTS ID
KIS_HTS_ID=

# --- Binance (출금 권한 OFF, IP 화이트리스트 권장) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- 알림 ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# --- 환율 데이터 (선택: 소스에 따라 필요) ---
FRED_API_KEY=
ECOS_API_KEY=
